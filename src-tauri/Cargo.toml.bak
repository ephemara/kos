[package]
name = "k-os-backend"
version = "0.1.0"
description = "K_OS High-Performance Rust Backend"
authors = ["K_OS Team"]
edition = "2021"
default-run = "k-os-backend"

# Only build the binary, not the library
# This avoids output filename collision
[[bin]]
name = "k-os-backend"
path = "src/main.rs"

# Bevy Renderer - The Dog (follows Tauri master window)
[[bin]]
name = "k-os-bevy"
path = "src/bevy/main.rs"

[build-dependencies]
tauri-build = { version = "2", features = [] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
toml = "0.8"
walkdir = "2"

[dependencies]
# Tauri v2 core
tauri = { version = "2", features = [] }
tauri-plugin-shell = "2"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"

# Linear Algebra - Phase 1
nalgebra = "0.33"
nalgebra-sparse = "0.10"

# Parallelism
rayon = "1.10"

# Fast binary serialization for large arrays
bincode = "1.3"

# Logging
log = "0.4"
env_logger = "0.11"

# Global state for sculpt mesh handles
lazy_static = "1.4"

# High-performance collision detection and raycasting (Phase 3.5)
parry3d = "0.17"

# --- K_OS ARSENAL (TIER 1) ---
# SIMD Math (The Engine)
glam = { version = "0.30", features = ["serde", "bytemuck"] }

# Memory Optimization (The Compressor)
half = { version = "2.3", features = ["serde", "bytemuck"] }

# Zero-Copy Serialization (The Bridge)
rkyv = "0.8"

# Casting (The Glue)
bytemuck = { version = "1.20", features = ["derive"] }

# Type Safety (The Shield - using stable 1.x for now)
specta = { version = "1.0", features = ["typescript", "serde"] }
# tauri-specta = { version = "2.0", features = ["derive", "typescript"] } # Waiting for stable

# --- K_OS ARSENAL (TIER 2) ---
# UV Unwrapping (The Map Maker)
xatlas = { package = "xatlas-rs", version = "0.1" }

# Mesh Optimization (The GPU Whisperer)
meshopt = "0.3"

# Procedural Noise (The Terrain Sculptor)
noise = "0.9"

# Fast noise functions (static permutation tables = faster!)
noise-functions = "0.4"

# Voronoi diagrams (cellular patterns)
voronoice = "0.2"

# KD-Tree (The Speed Demon) - faster than SpatialGrid
kiddo = "4.2"

# Fixed-size bitsets (The Dirty Tracker) - replaces HashSet overhead
fixedbitset = "0.5"

# Marching Cubes Remeshing (The Shape Shifter)
isosurface = "0.1.0-alpha.0"

# Random number generation
rand = "0.8"
fastrand = "2.0"  # Faster than rand for simple PRNG

# Base64 encoding for image data
base64 = "0.22"

# --- K_OS ARSENAL (TIER 3: PHYSICS) ---
# Physics Engine - standalone (for non-fluid physics)
# Note: For fluid simulation, we use salva3d's bundled rapier to avoid conflicts
rapier3d = { version = "0.22", features = ["simd-stable", "parallel"] }

# Fluid Simulation (The Liquid) - SPH solver with its own rapier version
salva3d = { version = "0.9", features = ["rapier"] }

# --- K_OS ARSENAL (TIER 4: IMAGE PROCESSING) ---
# Image I/O and basic operations
image = "0.25"

# Advanced image processing (filters, flood fill, transforms)
imageproc = "0.25"

# SIMD-accelerated image resizing (15x faster than JS!)
fast_image_resize = "4.2"

# --- K_OS ARSENAL (TIER 5: COMPRESSION) ---
# Lightning-fast compression for undo history (90% RAM savings!)
lz4_flex = "0.11"

# High-ratio compression for asset storage
zstd = "0.13"

# --- K_OS ARSENAL (TIER 6: CONCURRENCY) ---
# Better concurrency primitives than std
crossbeam = "0.8"

# Faster mutexes (2-5x faster than std::Mutex)
parking_lot = "0.12"

# --- K_OS ARSENAL (TIER 7: MEMORY) ---
# Memory-mapped files for large textures (4K+ without RAM explosion)
memmap2 = "0.9"

# N-dimensional arrays for texture data (NumPy in Rust)
ndarray = "0.16"

# --- K_OS ARSENAL (TIER 8: COLOR SCIENCE) ---
# Professional color space conversions (sRGB, LAB, HSL, etc)
palette = "0.7"

# --- K_OS ARSENAL (TIER 9: RAY TRACING) ---
# Fast BVH construction for ray tracing
bvh = "0.9"

# Spherical harmonics for lighting
# sh = "0.4"  # Add when needed

# --- K_OS ARSENAL (TIER 10: BEVY RENDERING) ---
# High-performance native renderer for KSculpt
# Raycasting and picking are BUILT INTO Bevy 0.17!
# file_watcher enables HOT RELOAD for textures, meshes, shaders, scenes
bevy = { version = "0.17", default-features = true, features = ["file_watcher"] }

# Camera controls (orbit, pan, zoom)
bevy_panorbit_camera = { version = "0.33", features = ["bevy_egui"] }

# Debug UI in Bevy window
bevy_egui = "0.38"

# --- K_OS ARSENAL (TIER 11: BEVY PLUGIN ECOSYSTEM) ---
# NOTE: These are added for future access. They won't compile until used in code.
# ⚠️ Some plugins commented out - waiting for Bevy 0.17 compatibility

# Selection & Picking - Click-to-select meshes in viewport
# NOTE: bevy 0.17 has built-in picking! Use bevy::picking module instead
# bevy_mod_picking = "0.22"  # May conflict with built-in picking

# Outline Shader - Visual feedback for selected objects
# bevy_mod_outline = "0.10"  # Check for 0.17 compat before enabling

# GPU Particle System - Particle brush effects, sparks, debris
bevy_hanabi = "0.17"

# Animation/Easing - Smooth camera transitions, UI animations
bevy_tweening = "0.14"

# Entity Inspector - Debug EVERYTHING live via egui panels
bevy-inspector-egui = "0.35"

# GPU COMPUTE (Tier 11) - WGPU for standalone compute shaders
# v26 uses naga v26, matching Bevy 0.17's internal version
wgpu = "26"
once_cell = "1.21"
pollster = "0.4.0"
glob = "0.3.3"
uuid = { version = "1.19.0", features = ["v4"] }
dirs = "6.0.0"

# Frame Rate Control - Consistent 60fps, reduce GPU heat
# bevy_framepace = "0.20"  # Latest is 0.20.1, needs 0.17 update

# GLTF Animation Helper - Easy animations from GLTF files  
# bevy_gltf_animation = "0.1"  # Check for 0.17 compat

# Cursor Tracking - World position, rays, multi-window support
# bevy_cursor = { version = "0.6", features = ["3d"] }  # Check for 0.17 compat

# Anti-aliasing - SMAA for smoother edges
# bevy_smaa = "0.8"  # Uncomment when ready to use

# Post Processing - Bloom, DOF, vignette (check for 0.17 compat)
# bevy_post_process = "0.5"  # Uncomment when ready to use


[profile.release]
lto = true
codegen-units = 1
panic = "abort"
opt-level = 3

[profile.dev]
# === FAST DEV BUILDS ===
opt-level = 1           # Some optimization (faster runtime, still fast compile)
debug = 0               # NO debug symbols = MUCH faster compile + link
incremental = true      # Incremental compilation (rebuild only changed code)
split-debuginfo = "unpacked"  # Windows: faster debug info handling

# Optimize ALL dependencies (they don't change often, compile once fast)
[profile.dev.package."*"]
opt-level = 2           # Full optimization for deps
debug = false           # No debug symbols for deps either
