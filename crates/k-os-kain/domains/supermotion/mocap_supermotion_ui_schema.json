    { "id": 4, "name": "spiral_stabilize", "group": "style", "params": [{ "key": "a.x", "label": "Spin Speed", "min": 0.0, "max": 20.0, "default": 2.0 }, { "key": "a.y", "label": "Radius", "min": 0.0, "max": 20.0, "default": 0.5 }, { "key": "b.x", "label": "Forward Blend", "min": 0.0, "max": 2.0, "default": 0.5 }] },
    { "id": 5, "name": "jitter_kill", "group": "stabilize", "params": [{ "key": "a.x", "label": "Anti-Jitter", "min": 0.0, "max": 8.0, "default": 2.0 }, { "key": "b.x", "label": "Residual Noise", "min": 0.0, "max": 1.0, "default": 0.05 }] },
