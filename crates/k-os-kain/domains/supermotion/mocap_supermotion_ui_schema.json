    { "id": 1, "name": "velocity_tail", "group": "stabilize", "params": [{ "key": "a.x", "label": "Lag", "min": 0.0, "max": 3.0, "default": 0.2 }] },
    { "id": 2, "name": "drag", "group": "stabilize", "params": [{ "key": "a.x", "label": "Drag Strength", "min": 0.0, "max": 8.0, "default": 1.0 }] },
