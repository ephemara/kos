    { "key": "global_intensity", "label": "Global Intensity", "min": 0.0, "max": 4.0, "default": 1.0, "tooltip": "Scales noise-sensitive modes." },
    { "key": "floor_y", "label": "Floor Y", "min": -500.0, "max": 500.0, "default": 0.0, "tooltip": "Floor plane height for lock/snap modes." }
  ],
  "mode_ui": [
