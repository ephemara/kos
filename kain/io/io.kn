enum Asset:
    Mesh(MeshAsset)
    Animation(AnimationAsset)
    Texture(TextureAsset)
    Material(MaterialAsset)
    SceneGraph(SceneGraphAsset)
    BinaryBlob(Array<u8>)

enum AssetType:
    Mesh
    Animation
    Texture
    Material
    SceneGraph
    BinaryBlob

impl Asset:
    fn asset_type(_self: &Self) -> AssetType:
        # <expr>


struct MeshAsset:
    positions: Array<f32>
    indices: Array<u32>
    normals: Option<Array<f32>>
    uvs: Option<Array<f32>>
    tangents: Option<Array<f32>>
    colors: Option<Array<f32>>

struct AnimationAsset:
    duration: f32
    keyframes: Array<Keyframe>
    curves: Array<AnimationCurve>
    skeleton: Option<SkeletonData>

struct Keyframe:
    time: f32
    transform: Transform

struct AnimationCurve:
    target: String
    property: String
    keyframes: Array<f32>

struct SkeletonData:
    bones: Array<Bone>
    bind_poses: Array<Transform>

struct Bone:
    name: String
    parent: Option<usize>

struct Transform:
    translation: Array<f32>
    rotation: Array<f32>
    scale: Array<f32>

struct TextureAsset:
    width: u32
    height: u32
    depth: u32
    format: TextureFormat
    mip_levels: u32
    data: Array<u8>

enum TextureFormat:
    RGBA8
    RGBA16F
    RGBA32F
    BC7
    BC5
    ETC2

struct MaterialAsset:
    shader: String
    parameters: Map<String, MaterialParam>
    textures: Map<String, AssetHandle>

enum MaterialParam:
    Float(f32)
    Vec2(Array<f32>)
    Vec3(Array<f32>)
    Vec4(Array<f32>)
    Int(i32)
    Bool(Bool)

struct SceneGraphAsset:
    nodes: Array<SceneNode>
    root_indices: Array<usize>

struct SceneNode:
    name: String
    transform: Transform
    mesh: Option<AssetHandle>
    material: Option<AssetHandle>
    children: Array<usize>

struct AssetMetadata:
    handle: AssetHandle
    asset_type: AssetType
    project_id: String
    tags: Array<String>
    size_bytes: u64
    created_at: i64
    modified_at: i64
    version: u32
    dependencies: Array<AssetHandle>
    content_hash: Array<u8>

