                        fn has_capability(_self: &Self_, capability: &String) -> Bool:
                            # <expr>

                            fn require_capability(_self: &Self_, capability: &String) -> Result<(), Error>:
                                # <expr>

                                fn add_restricted_resource(_self: &mut Self_, resource: impl_ Into<String>):
                                    # <expr>

                                    fn is_resource_restricted(_self: &Self_, resource: &String) -> Bool:
                                        # <expr>

                                        fn check_resource_access(_self: &Self_, resource: &String) -> Result<(), Error>:
                                            # <expr>

                                            fn set_data(_self: &mut Self_, key: impl_ Into<String>, value: serde_json::Value):
                                                # <expr>

                                                fn get_data(_self: &Self_, key: &String) -> Option<serde_json::Value>:
                                                    # <expr>

                                                    fn remove_data(_self: &mut Self_, key: &String) -> Option<serde_json::Value>:
                                                        # <expr>

                                                        fn clear_data(_self: &mut Self_):
                                                            # <expr>

                                                            fn log(_self: &Self_, level: LogLevel, message: &String):
                                                                # <expr>

                                                                impl Default for PluginContext:
                                                                    fn default_() -> Self_:
                                                                        # <expr>

                                                                        enum LogLevel:
                                                                            Trace
                                                                            Debug
                                                                            Info
                                                                            Warn
                                                                            Error

                                                                            enum PluginError:
                                                                                PluginNotFound(String)
                                                                                PluginAlreadyLoaded(String)
                                                                                LoadError(String)
                                                                                IncompatibleVersion { plugin_version: String, required_version: String }
                                                                                InitializationError(String)
                                                                                ShutdownError(String)
                                                                                SymbolNotFound(String)
                                                                                ResourceLimitExceeded { resource: String, limit: u64, current: u64 }
                                                                                AccessDenied(String)
                                                                                OperationFailed(String)
                                                                                IoError(std::io::Error)
                                                                                SemverError(semver::Error)
                                                                                Other(String)

                                                                                struct LoadedPlugin:
                                                                                    plugin: impl_ Plugin
                                                                                    library: libloading::Library
                                                                                    context: crate::PluginContext
                                                                                    resource_monitor: crate::ResourceMonitor
                                                                                    path: std::path::PathBuf

                                                                                    struct PluginManager:
