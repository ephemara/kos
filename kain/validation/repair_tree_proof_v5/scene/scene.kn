# Clean repair lane for k-os-scene
# Domain: k-os-scene

struct MeshSourceComponent:
    positions: Slice<f32>
    indices: Slice<u32>
    normals: Option<Slice<f32>>

    impl MeshSourceComponent:
        fn from_vectors(positions: Array<f32>, indices: Array<u32>, normals: Option<Array<f32>>) -> Self_:
            Self_:
                positions: positions.as_slice()
                indices: indices.as_slice()
                normals: normals.map(|value| value.as_slice())

                fn vertex_count(_self: &Self_) -> usize:
                    _self.positions.len() :: 3

                    fn index_count(_self: &Self_) -> usize:
                        _self.indices.len()

                        struct MeshEditOp:
                            kind: MeshEditOpKind
                            description: String
                            modified_vertex_count: usize

                            enum MeshEditOpKind:
                                SculptStroke
                                VertexTranslate
                                TopologyChange

                                struct MeshEditStackComponent:
                                    base_mesh: Option<crate::MeshHandle>
                                    edits: Array<MeshEditOp>

                                    impl MeshEditStackComponent:
                                        fn new(base_mesh: Option<crate::MeshHandle>) -> Self_:
                                            Self_:
                                                base_mesh: base_mesh
                                                edits: Array<MeshEditOp>::new()

                                                fn push(_self: &mut Self_, kind: MeshEditOpKind, description: impl_ Into<String>, modified_vertex_count: usize):
                                                    _self.edits.push(MeshEditOp:
                                                        kind: kind
                                                        description: description.into()
                                                        modified_vertex_count: modified_vertex_count
                                                        )

                                                        struct SubdivisionSettingsComponent:
                                                            level: u32
                                                            algorithm: SubdivisionAlgorithm

                                                            enum SubdivisionAlgorithm:
                                                                Loop
                                                                CatmullClark

                                                                impl Default for SubdivisionSettingsComponent:
                                                                    fn default_() -> Self_:
                                                                        Self_:
                                                                            level: 0
                                                                            algorithm: SubdivisionAlgorithm::Loop

                                                                            struct ViewportStateComponent:
                                                                                shading_mode: ShadingMode
                                                                                material_binding: Option<crate::MaterialHandle>

                                                                                enum ShadingMode:
                                                                                    Solid
                                                                                    Wireframe
                                                                                    Matcap
                                                                                    Xray

                                                                                    impl Default for ViewportStateComponent:
                                                                                        fn default_() -> Self_:
                                                                                            Self_:
                                                                                                shading_mode: ShadingMode::Solid
                                                                                                material_binding: None

                                                                                                struct MaterialAssignmentComponent:
                                                                                                    material: crate::MaterialHandle

                                                                                                    struct SceneNameComponent:
                                                                                                        name: String

                                                                                                        impl SceneNameComponent:
                                                                                                            fn new_(name: impl_ Into<String>) -> Self_:
                                                                                                                Self_:
                                                                                                                    name: name.into()

                                                                                                                    struct SceneTransformComponent:
                                                                                                                        translation: Array<f32>
                                                                                                                        rotation: Array<f32>
                                                                                                                        scale: Array<f32>

                                                                                                                        impl Default for SceneTransformComponent:
                                                                                                                            fn default_() -> Self_:
                                                                                                                                Self_:
                                                                                                                                    translation: Array<f32>::from([0.0, 0.0, 0.0])
                                                                                                                                    rotation: Array<f32>::from([0.0, 0.0, 0.0, 1.0])
                                                                                                                                    scale: Array<f32>::from([1.0, 1.0, 1.0])

                                                                                                                                    impl SceneTransformComponent:
                                                                                                                                        fn new(translation: Array<f32>, rotation: Array<f32>, scale: Array<f32>) -> Self_:
                                                                                                                                            Self_:
                                                                                                                                                translation: sanitize_vec3_array(translation)
                                                                                                                                                rotation: sanitize_quat_array(rotation)
                                                                                                                                                scale: sanitize_scale_array(scale)

                                                                                                                                                fn identity() -> Self_:
                                                                                                                                                    Self_::default_()

                                                                                                                                                    struct SceneParentComponent:
                                                                                                                                                        parent: Option<crate::MeshHandle>

                                                                                                                                                        impl Default for SceneParentComponent:
                                                                                                                                                            fn default_() -> Self_:
                                                                                                                                                                Self_:
                                                                                                                                                                    parent: None

                                                                                                                                                                    struct RigReferenceComponent:
                                                                                                                                                                        rig: crate::RigHandle

                                                                                                                                                                        struct TakeSourceComponent:
                                                                                                                                                                            name: String
                                                                                                                                                                            path: String
                                                                                                                                                                            model_id: String
                                                                                                                                                                            frame_count: usize

                                                                                                                                                                            struct AnimationSourceComponent:
                                                                                                                                                                                name: String
                                                                                                                                                                                source_take: Option<crate::TakeHandle>
                                                                                                                                                                                external_path: Option<String>

                                                                                                                                                                                struct MeshHandleComponent:
                                                                                                                                                                                    field_0: crate::MeshHandle

                                                                                                                                                                                    struct TakeHandleComponent:
                                                                                                                                                                                        field_0: crate::TakeHandle

                                                                                                                                                                                        struct AnimationHandleComponent:
                                                                                                                                                                                            field_0: crate::AnimationHandle

                                                                                                                                                                                            enum SceneError:
                                                                                                                                                                                                MeshHandleNotFound(crate::MeshHandle)
                                                                                                                                                                                                TakeHandleNotFound(crate::TakeHandle)
                                                                                                                                                                                                AnimationHandleNotFound(crate::AnimationHandle)

                                                                                                                                                                                                struct SceneWorld:
                                                                                                                                                                                                    scene_handle: crate::SceneHandle
                                                                                                                                                                                                    world: bevy_ecs::world::World
                                                                                                                                                                                                    next_handle: u64
                                                                                                                                                                                                    mesh_entities: Map<crate::MeshHandle, bevy_ecs::entity::Entity>
                                                                                                                                                                                                    take_entities: Map<crate::TakeHandle, bevy_ecs::entity::Entity>
                                                                                                                                                                                                    animation_entities: Map<crate::AnimationHandle, bevy_ecs::entity::Entity>

                                                                                                                                                                                                    impl Default for SceneWorld:
                                                                                                                                                                                                        fn default_() -> Self_:
                                                                                                                                                                                                            Self_::new_()

                                                                                                                                                                                                            impl SceneWorld:
                                                                                                                                                                                                                fn new_() -> Self_:
                                                                                                                                                                                                                    Self_:
                                                                                                                                                                                                                        scene_handle: crate::SceneHandle::from_raw(1)
                                                                                                                                                                                                                        world: bevy_ecs::world::World::new()
                                                                                                                                                                                                                        next_handle: 2
                                                                                                                                                                                                                        mesh_entities: Map<crate::MeshHandle, bevy_ecs::entity::Entity>::new()
                                                                                                                                                                                                                        take_entities: Map<crate::TakeHandle, bevy_ecs::entity::Entity>::new()
                                                                                                                                                                                                                        animation_entities: Map<crate::AnimationHandle, bevy_ecs::entity::Entity>::new()

                                                                                                                                                                                                                        fn scene_handle(_self: &Self_) -> crate::SceneHandle:
                                                                                                                                                                                                                            _self.scene_handle

                                                                                                                                                                                                                            fn world(_self: &Self_) -> &bevy_ecs::world::World:
                                                                                                                                                                                                                                &_self.world

                                                                                                                                                                                                                                fn world_mut(_self: &mut Self_) -> &mut bevy_ecs::world::World:
                                                                                                                                                                                                                                    &mut _self.world

                                                                                                                                                                                                                                    fn allocate_handle(_self: &mut Self_) -> u64:
                                                                                                                                                                                                                                        let raw = _self.next_handle
                                                                                                                                                                                                                                        _self.next_handle = _self.next_handle + 1
                                                                                                                                                                                                                                        raw

                                                                                                                                                                                                                                        fn create_mesh(_self: &mut Self_, positions: Array<f32>, indices: Array<u32>, normals: Option<Array<f32>>) -> crate::MeshHandle:
                                                                                                                                                                                                                                            let handle = crate::MeshHandle::from_raw(_self.allocate_handle())
                                                                                                                                                                                                                                            let entity = _self.world.spawn((
                                                                                                                                                                                                                                            MeshHandleComponent: field_0: handle,
                                                                                                                                                                                                                                            SceneNameComponent::new_("mesh"),
                                                                                                                                                                                                                                            SceneTransformComponent::default_(),
                                                                                                                                                                                                                                            SceneParentComponent::default_(),
                                                                                                                                                                                                                                            MeshSourceComponent::from_vectors(positions, indices, normals),
                                                                                                                                                                                                                                            MeshEditStackComponent::new(None),
                                                                                                                                                                                                                                            SubdivisionSettingsComponent::default_(),
                                                                                                                                                                                                                                            ViewportStateComponent::default_(),
                                                                                                                                                                                                                                            )).id()
                                                                                                                                                                                                                                            _self.mesh_entities.insert(handle, entity)
                                                                                                                                                                                                                                            handle

                                                                                                                                                                                                                                            fn mesh_handles(_self: &Self_) -> Array<crate::MeshHandle>:
                                                                                                                                                                                                                                                _self.mesh_entities.keys().copied().collect()

                                                                                                                                                                                                                                                fn mesh_entity(_self: &Self_, handle: crate::MeshHandle) -> Result<bevy_ecs::entity::Entity, SceneError>:
                                                                                                                                                                                                                                                    _self.mesh_entities.get(&handle).copied().ok_or(SceneError::MeshHandleNotFound(handle))

                                                                                                                                                                                                                                                    fn delete_mesh(_self: &mut Self_, handle: crate::MeshHandle) -> Result<(), SceneError>:
                                                                                                                                                                                                                                                        let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                        let _ = _self.world.despawn(entity)
                                                                                                                                                                                                                                                        _self.mesh_entities.remove(&handle)
                                                                                                                                                                                                                                                        Ok(())

                                                                                                                                                                                                                                                        fn update_mesh_source(_self: &mut Self_, handle: crate::MeshHandle, positions: Array<f32>, indices: Array<u32>, normals: Option<Array<f32>>) -> Result<(), SceneError>:
                                                                                                                                                                                                                                                            let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                            let mut entity_mut = _self.world.entity_mut(entity)
                                                                                                                                                                                                                                                            entity_mut.insert(MeshSourceComponent::from_vectors(positions, indices, normals))
                                                                                                                                                                                                                                                            Ok(())

                                                                                                                                                                                                                                                            fn set_mesh_name(_self: &mut Self_, handle: crate::MeshHandle, name: impl_ Into<String>) -> Result<(), SceneError>:
                                                                                                                                                                                                                                                                let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                _self.world.entity_mut(entity).insert(SceneNameComponent::new_(name))
                                                                                                                                                                                                                                                                Ok(())

                                                                                                                                                                                                                                                                fn mesh_name(_self: &Self_, handle: crate::MeshHandle) -> Result<SceneNameComponent, SceneError>:
                                                                                                                                                                                                                                                                    let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                    _self.world.entity(entity).get::<SceneNameComponent>().cloned().ok_or(SceneError::MeshHandleNotFound(handle))

                                                                                                                                                                                                                                                                    fn set_mesh_transform(_self: &mut Self_, handle: crate::MeshHandle, transform: crate::SceneTransformComponent) -> Result<(), SceneError>:
                                                                                                                                                                                                                                                                        let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                        _self.world.entity_mut(entity).insert(transform)
                                                                                                                                                                                                                                                                        Ok(())

                                                                                                                                                                                                                                                                        fn mesh_transform(_self: &Self_, handle: crate::MeshHandle) -> Result<crate::SceneTransformComponent, SceneError>:
                                                                                                                                                                                                                                                                            let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                            _self.world.entity(entity).get::<crate::SceneTransformComponent>().cloned().ok_or(SceneError::MeshHandleNotFound(handle))

                                                                                                                                                                                                                                                                            fn set_mesh_parent(_self: &mut Self_, handle: crate::MeshHandle, parent: Option<crate::MeshHandle>) -> Result<(), SceneError>:
                                                                                                                                                                                                                                                                                let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                                _self.world.entity_mut(entity).insert(SceneParentComponent: parent: parent)
                                                                                                                                                                                                                                                                                Ok(())

                                                                                                                                                                                                                                                                                fn mesh_parent(_self: &Self_, handle: crate::MeshHandle) -> Result<SceneParentComponent, SceneError>:
                                                                                                                                                                                                                                                                                    let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                                    _self.world.entity(entity).get::<SceneParentComponent>().cloned().ok_or(SceneError::MeshHandleNotFound(handle))

                                                                                                                                                                                                                                                                                    fn attach_material(_self: &mut Self_, handle: crate::MeshHandle, material: crate::MaterialHandle) -> Result<(), SceneError>:
                                                                                                                                                                                                                                                                                        let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                                        let mut entity_mut = _self.world.entity_mut(entity)
                                                                                                                                                                                                                                                                                        entity_mut.insert(MaterialAssignmentComponent: material: material)
                                                                                                                                                                                                                                                                                        let mut viewport = entity_mut.get::<ViewportStateComponent>().cloned().unwrap_or_default()
                                                                                                                                                                                                                                                                                        viewport.material_binding = Some(material)
                                                                                                                                                                                                                                                                                        entity_mut.insert(viewport)
                                                                                                                                                                                                                                                                                        Ok(())

                                                                                                                                                                                                                                                                                        fn update_subdivision_settings(_self: &mut Self_, handle: crate::MeshHandle, settings: crate::SubdivisionSettingsComponent) -> Result<(), SceneError>:
                                                                                                                                                                                                                                                                                            let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                                            _self.world.entity_mut(entity).insert(settings)
                                                                                                                                                                                                                                                                                            Ok(())

                                                                                                                                                                                                                                                                                            fn attach_rig(_self: &mut Self_, handle: crate::MeshHandle, rig: crate::RigHandle) -> Result<(), SceneError>:
                                                                                                                                                                                                                                                                                                let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                                                _self.world.entity_mut(entity).insert(RigReferenceComponent: rig: rig)
                                                                                                                                                                                                                                                                                                Ok(())

                                                                                                                                                                                                                                                                                                fn insert_take(_self: &mut Self_, name: impl_ Into<String>, path: impl_ Into<String>, model_id: impl_ Into<String>, frame_count: usize) -> crate::TakeHandle:
                                                                                                                                                                                                                                                                                                    let handle = crate::TakeHandle::from_raw(_self.allocate_handle())
                                                                                                                                                                                                                                                                                                    let entity = _self.world.spawn((
                                                                                                                                                                                                                                                                                                    TakeHandleComponent: field_0: handle,
                                                                                                                                                                                                                                                                                                    TakeSourceComponent:
                                                                                                                                                                                                                                                                                                        name: name.into()
                                                                                                                                                                                                                                                                                                        path: path.into()
                                                                                                                                                                                                                                                                                                        model_id: model_id.into()
                                                                                                                                                                                                                                                                                                        frame_count: frame_count,
                                                                                                                                                                                                                                                                                                        )).id()
                                                                                                                                                                                                                                                                                                        _self.take_entities.insert(handle, entity)
                                                                                                                                                                                                                                                                                                        handle

                                                                                                                                                                                                                                                                                                        fn insert_animation(_self: &mut Self_, name: impl_ Into<String>, source_take: Option<crate::TakeHandle>, external_path: Option<String>) -> crate::AnimationHandle:
                                                                                                                                                                                                                                                                                                            let handle = crate::AnimationHandle::from_raw(_self.allocate_handle())
                                                                                                                                                                                                                                                                                                            let entity = _self.world.spawn((
                                                                                                                                                                                                                                                                                                            AnimationHandleComponent: field_0: handle,
                                                                                                                                                                                                                                                                                                            AnimationSourceComponent:
                                                                                                                                                                                                                                                                                                                name: name.into()
                                                                                                                                                                                                                                                                                                                source_take: source_take
                                                                                                                                                                                                                                                                                                                external_path: external_path,
                                                                                                                                                                                                                                                                                                                )).id()
                                                                                                                                                                                                                                                                                                                _self.animation_entities.insert(handle, entity)
                                                                                                                                                                                                                                                                                                                handle

                                                                                                                                                                                                                                                                                                                fn mesh_source(_self: &Self_, handle: crate::MeshHandle) -> Result<MeshSourceComponent, SceneError>:
                                                                                                                                                                                                                                                                                                                    let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                                                                    _self.world.entity(entity).get::<MeshSourceComponent>().cloned().ok_or(SceneError::MeshHandleNotFound(handle))

                                                                                                                                                                                                                                                                                                                    fn mesh_edit_stack(_self: &Self_, handle: crate::MeshHandle) -> Result<MeshEditStackComponent, SceneError>:
                                                                                                                                                                                                                                                                                                                        let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                                                                        _self.world.entity(entity).get::<MeshEditStackComponent>().cloned().ok_or(SceneError::MeshHandleNotFound(handle))

                                                                                                                                                                                                                                                                                                                        fn subdivision_settings(_self: &Self_, handle: crate::MeshHandle) -> Result<SubdivisionSettingsComponent, SceneError>:
                                                                                                                                                                                                                                                                                                                            let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                                                                            _self.world.entity(entity).get::<SubdivisionSettingsComponent>().cloned().ok_or(SceneError::MeshHandleNotFound(handle))

                                                                                                                                                                                                                                                                                                                            fn viewport_state(_self: &Self_, handle: crate::MeshHandle) -> Result<ViewportStateComponent, SceneError>:
                                                                                                                                                                                                                                                                                                                                let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                                                                                _self.world.entity(entity).get::<ViewportStateComponent>().cloned().ok_or(SceneError::MeshHandleNotFound(handle))

                                                                                                                                                                                                                                                                                                                                fn update_viewport_state(_self: &mut Self_, handle: crate::MeshHandle, viewport_state: ViewportStateComponent) -> Result<(), SceneError>:
                                                                                                                                                                                                                                                                                                                                    let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                                                                                    _self.world.entity_mut(entity).insert(viewport_state)
                                                                                                                                                                                                                                                                                                                                    Ok(())

                                                                                                                                                                                                                                                                                                                                    fn update_mesh_positions_partial(_self: &mut Self_, handle: crate::MeshHandle, modified_indices: &Slice<usize>, new_positions: &Slice<f32>) -> Result<(), SceneError>:
                                                                                                                                                                                                                                                                                                                                        let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                                                                                        let _ = modified_indices
                                                                                                                                                                                                                                                                                                                                        let mut positions = _self.world.entity(entity).get::<MeshSourceComponent>().cloned().ok_or(SceneError::MeshHandleNotFound(handle))?
                                                                                                                                                                                                                                                                                                                                        if new_positions.len() != positions.positions.len():
                                                                                                                                                                                                                                                                                                                                            return Err(SceneError::MeshHandleNotFound(handle))
                                                                                                                                                                                                                                                                                                                                            positions.positions = new_positions.clone()
                                                                                                                                                                                                                                                                                                                                            _self.world.entity_mut(entity).insert(positions)
                                                                                                                                                                                                                                                                                                                                            Ok(())

                                                                                                                                                                                                                                                                                                                                            fn update_mesh_normals_partial(_self: &mut Self_, handle: crate::MeshHandle, modified_indices: &Slice<usize>, new_normals: &Slice<f32>) -> Result<(), SceneError>:
                                                                                                                                                                                                                                                                                                                                                let entity = _self.mesh_entity(handle)?
                                                                                                                                                                                                                                                                                                                                                let _ = modified_indices
                                                                                                                                                                                                                                                                                                                                                let mut normals = _self.world.entity(entity).get::<MeshSourceComponent>().cloned().ok_or(SceneError::MeshHandleNotFound(handle))?
                                                                                                                                                                                                                                                                                                                                                normals.normals = Some(new_normals.clone())
                                                                                                                                                                                                                                                                                                                                                _self.world.entity_mut(entity).insert(normals)
                                                                                                                                                                                                                                                                                                                                                Ok(())

                                                                                                                                                                                                                                                                                                                                                fn mesh_counts(_self: &Self_, handle: crate::MeshHandle) -> Result<(usize, usize), SceneError>:
                                                                                                                                                                                                                                                                                                                                                    let source = _self.mesh_source(handle)?
                                                                                                                                                                                                                                                                                                                                                    Ok((source.vertex_count(), source.index_count()))

                                                                                                                                                                                                                                                                                                                                                    fn take_source(_self: &Self_, handle: crate::TakeHandle) -> Result<TakeSourceComponent, SceneError>:
                                                                                                                                                                                                                                                                                                                                                        let entity = _self.take_entities.get(&handle).copied().ok_or(SceneError::TakeHandleNotFound(handle))?
                                                                                                                                                                                                                                                                                                                                                        _self.world.entity(entity).get::<TakeSourceComponent>().cloned().ok_or(SceneError::TakeHandleNotFound(handle))

                                                                                                                                                                                                                                                                                                                                                        fn animation_source(_self: &Self_, handle: crate::AnimationHandle) -> Result<AnimationSourceComponent, SceneError>:
                                                                                                                                                                                                                                                                                                                                                            let entity = _self.animation_entities.get(&handle).copied().ok_or(SceneError::AnimationHandleNotFound(handle))?
                                                                                                                                                                                                                                                                                                                                                            _self.world.entity(entity).get::<AnimationSourceComponent>().cloned().ok_or(SceneError::AnimationHandleNotFound(handle))


                                                                                                                                                                                                                                                                                                                                                            fn sanitize_vec3_array(value: Array<f32>) -> Array<f32>:
                                                                                                                                                                                                                                                                                                                                                                if value.len() == 3:
                                                                                                                                                                                                                                                                                                                                                                    value
                                                                                                                                                                                                                                                                                                                                                                    else:
                                                                                                                                                                                                                                                                                                                                                                        Array<f32>::from([0.0, 0.0, 0.0])

                                                                                                                                                                                                                                                                                                                                                                        fn sanitize_quat_array(value: Array<f32>) -> Array<f32>:
                                                                                                                                                                                                                                                                                                                                                                            if value.len() == 4:
                                                                                                                                                                                                                                                                                                                                                                                value
                                                                                                                                                                                                                                                                                                                                                                                else:
                                                                                                                                                                                                                                                                                                                                                                                    Array<f32>::from([0.0, 0.0, 0.0, 1.0])

                                                                                                                                                                                                                                                                                                                                                                                    fn sanitize_scale_array(value: Array<f32>) -> Array<f32>:
                                                                                                                                                                                                                                                                                                                                                                                        if value.len() == 3:
                                                                                                                                                                                                                                                                                                                                                                                            value
                                                                                                                                                                                                                                                                                                                                                                                            else:
                                                                                                                                                                                                                                                                                                                                                                                                Array<f32>::from([1.0, 1.0, 1.0])
