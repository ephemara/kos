# Clean repair lane for pipeline orchestration

trait_ AssetImporter:
    fn supported_extensions(_self: &Self_) -> Array<&str>
    fn import(_self: &Self_, path: &std::path::Path) -> Result<crate::asset::Asset, Error>
    fn name(_self: &Self_) -> &str

    trait_ AssetExporter:
        fn supported_formats(_self: &Self_) -> Array<&str>
        fn export(_self: &Self_, asset: &crate::asset::Asset, path: &std::path::Path) -> Result<(), Error>
        fn name(_self: &Self_) -> &str

        trait_ AssetProcessor:
            fn process(_self: &Self_, asset: &mut crate::asset::Asset) -> Result<(), Error>
            fn name(_self: &Self_) -> &str
            fn should_process(_self: &Self_, asset: &crate::asset::Asset) -> Bool

            struct_ AssetPipeline:
                cache: crate::cache::AssetCache
                importers: Map<String, impl_ AssetImporter>
                exporters: Map<String, impl_ AssetExporter>
                processors: Array<impl_ AssetProcessor>

                impl_ AssetPipeline:
                    fn new_(cache_dir: std::path::PathBuf) -> Result<Self_, Error>:
                        let cache = crate::cache::AssetCache::new_(cache_dir)?
                        Self_:
                            cache: cache
                            importers: Map<String, impl_ AssetImporter>::new()
                            exporters: Map<String, impl_ AssetExporter>::new()
                            processors: Array<impl_ AssetProcessor>::new()

                            fn register_importer(_self: &Self_, importer: impl_ AssetImporter):
                                for ext in importer.supported_extensions():
                                    _self.importers.insert(ext.to_lowercase(), importer)

                                    fn register_exporter(_self: &Self_, exporter: impl_ AssetExporter):
                                        for format in exporter.supported_formats():
                                            _self.exporters.insert(format.to_lowercase(), exporter)

                                            fn register_processor(_self: &Self_, processor: impl_ AssetProcessor):
                                                _self.processors.push(processor)

                                                fn import(_self: &Self_, path: &std::path::Path) -> Result<crate::asset::Asset, Error>:
                                                    if !path.exists():
                                                        return Err(Error::FileNotFound(path.to_path_buf()))

                                                        if let Some(cached_asset) = _self.cache.get(path)?:
                                                            return Ok(cached_asset)

                                                            let extension = match path.extension().and_then(|e| e.to_str()):
                                                                Some(ext): ext.to_lowercase()
                                                                None: return Err(Error::UnsupportedFormat:
                                                                    extension: "none"
                                                                    supported: _self.list_supported_import_formats()
                                                                    )

                                                                    let importer = match _self.importers.get(&extension):
                                                                        Some(importer): importer
                                                                        None: return Err(Error::UnsupportedFormat:
                                                                            extension: extension
                                                                            supported: _self.list_supported_import_formats()
                                                                            )

                                                                            let mut asset = importer.import(path)?
                                                                            asset.id = crate::hash::hash_file(path)?
                                                                            _self.process(&mut asset)?
                                                                            _self.cache.put(&asset)?
                                                                            Ok(asset)

                                                                            fn export(_self: &Self_, asset: &crate::asset::Asset, path: &std::path::Path, format: &str) -> Result<(), Error>:
                                                                                let format = format.to_lowercase()
                                                                                let exporter = match _self.exporters.get(&format):
                                                                                    Some(exporter): exporter
                                                                                    None: return Err(Error::UnsupportedFormat:
                                                                                        extension: format
                                                                                        supported: _self.list_supported_export_formats()
                                                                                        )
                                                                                        exporter.export(asset, path)

                                                                                        fn process(_self: &Self_, asset: &mut crate::asset::Asset) -> Result<(), Error>:
                                                                                            for processor in _self.processors.iter():
                                                                                                if processor.should_process(asset):
                                                                                                    processor.process(asset)?
                                                                                                    Ok(())

                                                                                                    fn clear_cache(_self: &Self_) -> Result<(), Error>:
                                                                                                        _self.cache.clear()

                                                                                                        fn cache_stats(_self: &Self_) -> crate::cache::CacheStats:
                                                                                                            _self.cache.stats()

                                                                                                            fn list_supported_import_formats(_self: &Self_) -> String:
                                                                                                                let mut formats: Array<String> = _self.importers.keys().map(|k| k.clone()).collect()
                                                                                                                formats.sort()
                                                                                                                formats.join(", ")

                                                                                                                fn list_supported_export_formats(_self: &Self_) -> String:
                                                                                                                    let mut formats: Array<String> = _self.exporters.keys().map(|k| k.clone()).collect()
                                                                                                                    formats.sort()
                                                                                                                    formats.join(", ")

                                                                                                                    # Heavy codec-specific importers::exporters stay out of this repair lane.
                                                                                                                    # They should be reattached from host-backed Rust or generated backends later.
