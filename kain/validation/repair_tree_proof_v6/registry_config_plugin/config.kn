                                                                                                                                                                                                                                                                                                    struct ConfigWatcher:
                                                                                                                                                                                                                                                                                                        watcher: impl_ Watcher
                                                                                                                                                                                                                                                                                                        receiver: std::sync::mpsc::Receiver<Result<notify::Event, notify::Error>>
