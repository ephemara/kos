# Kain repair lane: config loader :: registry :: schema :: watcher

struct ConfigLoader:
    user_config_dir: std::path::PathBuf
    project_config_dir: Option<std::path::PathBuf>

    enum ConfigCategory:
        Brushes
        Tools
        ExportFormats
        ViewportPresets
        GreeblePatterns

        struct ValidationResult:
            valid: Bool
            errors: Array<String>
            warnings: Array<String>
            brush_count: usize
            tool_count: usize
            export_format_count: usize
            viewport_preset_count: usize
            greeble_pattern_count: usize

            struct ConfigPaths:
                user_config_dir: String
                project_config_dir: Option<String>

                struct ConfigRegistry:
                    brushes: Map<String, BrushConfig>
                    tools: Map<String, ToolConfig>
                    export_formats: Map<String, ExportFormatConfig>
                    viewport_presets: Map<String, ViewportPresetConfig>
                    greeble_patterns: Map<String, GreeblePatternConfig>
                    shading_modes: Map<String, ShadingModeConfig>

                    struct BrushConfig:
                        id: String
                        name: String
                        category: BrushCategory
                        default_size: f32
                        default_strength: f32
                        supports_pressure: Bool
                        gpu_shader: Option<String>
                        icon: String
                        parameters: Map<String, BrushParameter>

                        enum BrushCategory:
                            Sculpt
                            Paint
                            Mask
                            Smooth

                            enum BrushParameter:
                                Float { default_: f32, min: f32, max: f32 }
                                Int { default_: i32, min: i32, max: i32 }
                                Bool { default_: Bool }
                                Color { default_: Array<f32> }

                                struct ToolConfig:
                                    id: String
                                    name: String
                                    category: String
                                    icon: String
                                    shortcut: Option<String>
                                    parameters: Map<String, BrushParameter>

                                    struct ExportFormatConfig:
                                        id: String
                                        name: String
                                        extensions: Array<String>
                                        supports_meshes: Bool
                                        supports_textures: Bool
                                        supports_materials: Bool
                                        options: Array<ExportOption>

                                        struct ExportOption:
                                            id: String
                                            label: String
                                            value_type: ExportOptionType

                                            enum ExportOptionType:
                                                Bool { default_: Bool }
                                                Int { default_: i32, min: i32, max: i32 }
                                                Float { default_: f32, min: f32, max: f32 }
                                                Enum { default_: String, values: Array<String> }

                                                struct ViewportPresetConfig:
                                                    id: String
                                                    name: String
                                                    grid_size: f32
                                                    grid_divisions: u32
                                                    camera_distance: f32
                                                    camera_fov: f32
                                                    lighting: LightingConfig

                                                    struct LightingConfig:
                                                        ambient: f32
                                                        directional: DirectionalLight

                                                        struct DirectionalLight:
                                                            intensity: f32
                                                            direction: Array<f32>

                                                            struct ShadingModeConfig:
                                                                id: String
                                                                name: String
                                                                app: String
                                                                mode_index: u32
                                                                icon: Option<String>
                                                                description: Option<String>

                                                                struct GreeblePatternConfig:
                                                                    id: String
                                                                    name: String
                                                                    category: String
                                                                    primitives: Array<GreeblePrimitive>

                                                                    struct GreeblePrimitive:
                                                                        primitive_type: PrimitiveType
                                                                        probability: f32
                                                                        scale_range: ScaleRange

                                                                        enum PrimitiveType:
                                                                            Box
                                                                            Cylinder
                                                                            Sphere
                                                                            Custom

                                                                            struct ScaleRange:
                                                                                min: Array<f32>
                                                                                max: Array<f32>

                                                                                struct RootConfig:
                                                                                    brushes: Array<BrushConfig>
                                                                                    tools: Array<ToolConfig>
                                                                                    export_formats: Array<ExportFormatConfig>
                                                                                    viewport_presets: Array<ViewportPresetConfig>
                                                                                    greeble_patterns: Array<GreeblePatternConfig>
                                                                                    shading_modes: Array<ShadingModeConfig>

                                                                                    impl Default for RootConfig:
                                                                                        fn default_() -> Self::
                                                                                            # <expr>

                                                                                            impl Default for LightingConfig:
                                                                                                fn default_() -> Self::
                                                                                                    # <expr>

                                                                                                    impl Default for ConfigRegistry:
                                                                                                        fn default_() -> Self::
