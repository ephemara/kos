struct BrushPreset:
    id: String
    spacing: Float
    jitter: Float
    registry_path: String

fn default_brush_preset() -> BrushPreset with Pure:
    let preset = BrushPreset()
    preset.id = "ink_liner"
    preset.spacing = 0.08
    preset.jitter = 0.01
    preset.registry_path = "src-kain/domains/brush/brush_builder_registry.json"
    preset
