struct FluidBuilderConfig:
    default_domain: String
    runtime_registry_path: String
    profile_registry_path: String
    output_root: String

fn fluid_builder_config() -> FluidBuilderConfig with Pure:
    let config = FluidBuilderConfig()
    config.default_domain = "fluid"
    config.runtime_registry_path = "crates/k-os-kain/generated/json/runtime_registry.json"
    config.profile_registry_path = "sources/kain/domains/fluid/fluid_builder_registry.json"
    config.output_root = "crates/k-os-kain/generated/runtime"
    config
