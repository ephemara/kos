{
  "legacyBundle": {
    "workingDir": "archive/oldkos",
    "distDir": "dist",
    "stageDir": "dist/legacy",
    "entryPoint": "legacy/index.html",
    "extraFiles": [
      "metadata.json",
      "README.md"
    ]
  },
  "pythonSidecar": {
    "enabledByDefault": false,
    "buildScript": "sources/python/build.py",
    "artifact": "sources/python/dist/kos_python",
    "entryPoint": "kos_python.exe",
    "bundleTarget": "apps/tauri/resources/bin/kos_python"
  },
  "nativeLaunchers": [
    {
      "id": "zen",
      "enabledByDefault": true,
      "build": {
        "command": "cargo",
        "args": [
          "build",
          "-p",
          "zen",
          "--release"
        ]
      },
      "binary": "target/release/zen.exe",
      "bundleTarget": "apps/tauri/resources/bin/zen/zen.exe",
      "resourceCopies": [
        {
          "source": "apps/zen/resources/runtime.toml",
          "target": "apps/tauri/resources/bin/zen/runtime.toml"
        },
        {
          "source": "apps/zen/resources/input_bindings.toml",
          "target": "apps/tauri/resources/bin/zen/input_bindings.toml"
        }
      ]
    }
  ],
  "portablePackage": {
    "stagingDir": "target/release/bundle/portable/app",
    "archivePath": "target/release/bundle/portable/K_OS_9.0.2_x64.7z",
    "outputPath": "target/release/bundle/portable/K_OS.exe",
    "title": "K_OS 9.0.2",
    "installPath": "%LOCALAPPDATA%\\\\K_OS\\\\9.0.2",
    "runProgram": "k-os-backend.exe",
    "compressionLevel": 1,
    "sfxModuleCandidates": [
      "C:/Program Files/7-Zip/7z.sfx",
      "C:/Users/Admin/scoop/apps/7zip/current/7z.sfx"
    ],
    "entries": [
      {
        "source": "target/release/k-os-backend.exe",
        "target": "k-os-backend.exe"
      },
      {
        "source": "target/release/DirectML.dll",
        "target": "DirectML.dll"
      },
      {
        "source": "target/release/k_os_wasm.dll",
        "target": "k_os_wasm.dll"
      },
      {
        "source": "apps/tauri/resources",
        "target": "resources"
      }
    ]
  },
  "resourceCopies": [
    {
      "source": "sources/game/assets",
      "target": "apps/tauri/resources/runtime/game-assets"
    },
    {
      "source": "sources/python/main.py",
      "target": "apps/tauri/resources/runtime/python-source/main.py"
    },
    {
      "source": "sources/python/kos",
      "target": "apps/tauri/resources/runtime/python-source/kos"
    },
    {
      "source": "sources/python/requirements.txt",
      "target": "apps/tauri/resources/runtime/python-source/requirements.txt"
    },
    {
      "source": "sources/python/requirements-autopbr.txt",
      "target": "apps/tauri/resources/runtime/python-source/requirements-autopbr.txt"
    },
    {
      "source": "sources/python/requirements-photogrammetry.txt",
      "target": "apps/tauri/resources/runtime/python-source/requirements-photogrammetry.txt"
    },
    {
      "source": "crates/k-os-kain",
      "target": "apps/tauri/resources/kain-workspace/crates/k-os-kain"
    },
    {
      "source": "sources/kain",
      "target": "apps/tauri/resources/kain-workspace/sources/kain"
    }
  ]
}
