{
  "name": "k-os-dashboard",
  "private": true,
  "version": "9.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:frontend": "tsc && vite build",
    "build": "npm run build:frontend && node scripts/prepare-release.mjs",
    "build:with-python": "npm run build:frontend && powershell -NoProfile -Command \"$env:KOS_INCLUDE_PYTHON_SIDECAR='1'; node scripts/prepare-release.mjs\"",
    "package:portable": "node scripts/package-portable.mjs",
    "release:windows": "npm run build && cargo build --workspace --release && npm run package:portable",
    "wasm:build": "wasm-pack build crates/k-os-wasm --target web --out-dir public/pkg --out-name k_os_wasm",
    "dev:web": "npm run wasm:build && vite",
    "build:web": "npm run wasm:build && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles nsis",
    "tauri:build:nsis": "tauri build --bundles nsis",
    "test": "vitest run",
    "test:smoke": "vitest run src-frontend/tests/backend-frontend-hybrid.test.ts src-frontend/tests/dcc-suite-regression.test.ts src-frontend/tests/dcc-suite-wide-coverage.test.tsx src-frontend/tests/mocap-interop.test.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
