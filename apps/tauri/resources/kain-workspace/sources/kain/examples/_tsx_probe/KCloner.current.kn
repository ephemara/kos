                let iter_5 = p.sliders
                let index_6 = 0
                while (index_6 < iter_5.length):
                    let s = iter_5[index_6]
                    v[s.id] = s.val
                    index_6 = (index_6 + 1)
            if ((!script) || (script.raw != p.code)):
                script = scriptCache.current[cacheKey]
            if script.valid:
                pass
            break

    fn handleImport():
        if fileInputRef.current:
            fileInputRef.current.click()

    fn handleBake():
        if baking:
            return
        let group = meshGroupRef.current
        if ((!group) || (group.children.length == 0)):
            setStatus("Error: No clones to export")
            return
        setBaking(true)
        setStatus("Exporting clones...")

    fn handleAddModifier(key: String):
        let newMod = createModifierInstance(key)
        setChains(
            fn(prev: Any): prev.map(
                            fn(c: Any): if (c.id == activeChainId):
                                                Any()
                                            else:
                                                c
                        )
        )
        if activeChainId:
            setSelectedModId(newMod.instanceId)

    fn handleAction(type_: String, payload: Any):
        if (type_ == "ADD_CHAIN"):
            setChains(fn(p: Any): [p, createChainInstance(p.length)])
        else if (type_ == "REMOVE_CHAIN"):
            setChains(fn(p: Any): p.filter(fn(c: Any): (c.id != payload)))
            if (activeChainId == payload):
                setActiveChainId(chains[0].id)
        else if (type_ == "UPDATE_CHAIN"):
            setChains(
                fn(p: Any): p.map(
                                    fn(c: Any): if (c.id == payload.id):
                                                            Any()
                                                        else:
                                                            c
                                )
            )
        else if (type_ == "REMOVE_MOD"):
            setChains(
                fn(p: Any): p.map(
                                    fn(c: Any): if (c.id == activeChainId):
                                                            Any()
                                                        else:
                                                            c
                                )
            )
        else if (type_ == "UPDATE_PARAM"):
            setChains(
                fn(p: Any): p.map(
                                    fn(c: Any): if (c.id == activeChainId):
                                                            Any()
                                                        else:
                                                            c
                                )
            )

    fn setUiTime(value: Any):
        uiTime = value

    render <AppShell menuBar={<AppMenuBar />} topBar={<TopBar exportFormat={exportFormat} setExportFormat={setExportFormat} exportMode={exportMode} setExportMode={setExportMode} targetEngine={targetEngine} setTargetEngine={setTargetEngine} splitAnimations={splitAnimations} setSplitAnimations={setSplitAnimations} baking={baking} onImport={handleImport} onBrowse={none} onUplink={none} onBake={handleBake} cloneCount={if (clonerMode == "GRID"):
    ((clonerCount.x * clonerCount.y) * clonerCount.z)
else:
    if (clonerMode == "RADIAL"):
        radialCount
    else:
        if (clonerMode == "LINEAR"):
            clonerCount.y
        else:
            1} />} left={Any()} right={Any()} bottom={<Sequencer currentFrame={Math.floor(
    ((if isPlaying:
            uiTime
        else:
            timeRef.current) * fps)
)} totalFrames={Math.floor((totalDuration * fps))} fps={fps} isPlaying={isPlaying} onPlayPause={setIsPlaying} onSeek={none} tracks={sequencerTracks} activeTrackId={none} onSelectTrack={none} onAddKeyframe={none} onDeleteKeyframe={none} />}><div ref={mountRef} className="w-full h-full relative group"><input type="file" ref={fileInputRef} onChange={handleImport} className="hidden" /></div></AppShell>

